    CONTROL         "Generate XML File(s)",IDC_GENERATE_XML_FILES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,69,37,82,10
    CONTROL         "Create Subfolders",IDC_CREATE_SUBFOLDERS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,157,37,72,10
