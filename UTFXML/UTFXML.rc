    PUSHBUTTON      "Generate",IDC_GENERATE_BUTTON,291,137,50,14
    GROUPBOX        "Skip Folders",IDC_STATIC,7,160,68,71
    CONTROL         "Audio",IDC_SKIP_AUDIO,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,16,174,34,10
