IDD_UTFXML_DIALOG DIALOGEX 0, 0, 280, 235
STYLE DS_MODALFRAME | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | 
    WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Freelancer UTF to XML Converter"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Source Path",IDC_STATIC,7,8,40,8
    CONTROL         "Recursive",IDC_RECURSIVE,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,69,7,48,10
    EDITTEXT        IDC_SOURCE_PATH,7,18,266,12,ES_AUTOHSCROLL
    LTEXT           "Destination Path",IDC_STATIC,7,38,53,8
    CONTROL         "Generate XML File(s)",IDC_GENERATE_XML_FILES,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,69,37,82,10
    CONTROL         "Create Subfolders",IDC_CREATE_SUBFOLDERS,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,157,37,72,10
    EDITTEXT        IDC_DESTINATION_PATH,7,48,266,12,ES_AUTOHSCROLL
    LTEXT           "UTF Filename(s)",IDC_STATIC,7,68,52,8
    COMBOBOX        IDC_UTF_FILENAMES,7,78,249,112,CBS_DROPDOWN | 
                    CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "...",IDC_BROWSE_UTF_FILENAME,262,77,11,14
    LTEXT           "Strings List",IDC_STATIC,7,98,76,8
    EDITTEXT        IDC_STRINGS_LIST,7,108,210,12,ES_AUTOHSCROLL
    PUSHBUTTON      "Generate",IDC_GENERATE_BUTTON,223,107,50,14
    GROUPBOX        "Skip Folders",IDC_STATIC,7,130,68,71
    CONTROL         "Audio",IDC_SKIP_AUDIO,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,16,144,34,10
    CONTROL         "Bases",IDC_SKIP_BASES,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,16,157,35,10
    CONTROL         "Characters",IDC_SKIP_CHARACTERS,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,16,170,50,10
    CONTROL         "FX",IDC_SKIP_FX,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,
                    16,183,25,10
    GROUPBOX        "Extract",IDC_STATIC,85,130,107,71
    CONTROL         "Audio Files (.wav)",IDC_EXTRACT_AUDIO_FILES,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,94,144,71,10
    CONTROL         "Texture Files (.dds .tga)",IDC_EXTRACT_TEXTURE_FILES,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,94,157,89,10
    CONTROL         "Include Files",IDC_EXTRACT_INCLUDE_FILES,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,94,170,55,10
    GROUPBOX        "Options",IDC_STATIC,202,130,71,71
    CONTROL         "Timestamps",IDC_OPTION_TIMESTAMPS,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,211,144,53,10
    CONTROL         "Degrees",IDC_OPTION_DEGREES,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,211,157,43,10
    CONTROL         "Rotation",IDC_OPTION_ROTATION,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,211,170,43,10
    CONTROL         "RGB (decimal)",IDC_OPTION_RGB,"Button",BS_AUTO3STATE | 
                    WS_TABSTOP,211,183,61,10
    PUSHBUTTON      "Help",IDC_HELP_BUTTON,103,210,50,18,NOT WS_VISIBLE
    DEFPUSHBUTTON   "Convert",IDC_CONVERT,163,210,50,18
    PUSHBUTTON      "Exit",IDCANCEL,223,210,50,18
END

